# ── Transcription mode ─────────────────────────────────────────────────────────
# "offline": faster-whisper only — no internet needed after model download.
# "online":  whisper STT + DeepSeek V4 Flash text cleaning (punctuation, tone).
TRANSCRIPTION_MODE=online

# ── Whisper (local speech-to-text, both modes) ─────────────────────────────────
# Faster-whisper model size — smaller = faster, larger = more accurate.
# Options: tiny.en, tiny, base.en, base, small.en, small, distil-small.en
WHISPER_MODEL=tiny.en
# "auto" picks CUDA on machines with an NVIDIA GPU — if cuBLAS isn't installed,
# whisper fails with "Library cublas64_12.dll is not found". Use "cpu" to be safe.
WHISPER_DEVICE=auto          # "auto", "cpu", or "cuda"
WHISPER_COMPUTE_TYPE=auto    # "auto", "int8" (fastest CPU), "float16" (GPU)

# ── DeepSeek (online text cleaning) ─────────────────────────────────────────────
# Required when TRANSCRIPTION_MODE=online. Get a key at platform.deepseek.com.
# Pricing (2026): $0.14/1M input, $0.28/1M output — fractions of a cent per dictation.
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Server Configuration ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins, or * for dev)
ALLOWED_ORIGINS=*

# Authentication — set this in production to protect /process-audio
# API_TOKEN=

# Logging
LOG_LEVEL=INFO
# LOG_FORMAT=json   # set to "json" for Cloud Run / structured logs

# Audio limits
# MAX_AUDIO_MB=20

# Rate limiting (requests per minute per client, 0 = disabled)
# RATE_LIMIT_PER_MINUTE=30
