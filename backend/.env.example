# ── Transcription engine ───────────────────────────────────────────────────────
# "gemini" (cloud, requires API key) or "whisper" (local, works offline)
TRANSCRIPTION_ENGINE=gemini

# ── Whisper (local offline transcription) ───────────────────────────────────────
# Faster-whisper model size — smaller = faster, larger = more accurate.
# Options: tiny.en, tiny, base.en, base, small.en, small, distil-small.en
# WHISPER_MODEL=tiny.en
# WHISPER_DEVICE=auto          # "auto", "cpu", or "cuda"
# WHISPER_COMPUTE_TYPE=auto    # "auto", "int8" (fastest CPU), "float16" (GPU)

# ── Gemini (cloud transcription) ────────────────────────────────────────────────
# Required when TRANSCRIPTION_ENGINE=gemini.
GEMINI_API_KEY=your-gemini-api-key-here
# Stable alias that always points to the newest Flash model.
GEMINI_MODEL=gemini-flash-latest

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins, or * for dev)
ALLOWED_ORIGINS=*

# Authentication — set this in production to protect /process-audio
# API_TOKEN=

# Logging
LOG_LEVEL=INFO
# LOG_FORMAT=json   # set to "json" for Cloud Run / structured logs

# Audio limits
# MAX_AUDIO_MB=20

# Rate limiting (requests per minute per client, 0 = disabled)
# RATE_LIMIT_PER_MINUTE=30
