# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins, or * for dev)
ALLOWED_ORIGINS=*

# Authentication — set this in production to protect /process-audio
# API_TOKEN=

# Logging
LOG_LEVEL=INFO
# LOG_FORMAT=json   # set to "json" for Cloud Run / structured logs

# Audio limits
# MAX_AUDIO_MB=20

# Rate limiting (requests per minute per client, 0 = disabled)
# RATE_LIMIT_PER_MINUTE=30
