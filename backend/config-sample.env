# Vocatype Backend — Full Configuration Reference
#
# Copy this file to `.env` and fill in the values you need. Every option below is
# documented so you can tune the service for development or production.
# ──────────────────────────────────────────────────────────────────────────────

# ── Gemini (required) ─────────────────────────────────────────────────────────
# API key from https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here

# Model used for transcription + text processing.
# gemini-flash-latest is a stable alias for the newest Flash model and is the
# recommended default. Older models (gemini-1.5-flash, gemini-2.x) may be
# unavailable to new accounts.
# GEMINI_MODEL=gemini-flash-latest

# ── Server ────────────────────────────────────────────────────────────────────
# Address to bind. Use 0.0.0.0 for containers / remote access, 127.0.0.1 for local-only.
# HOST=0.0.0.0

# Port to listen on. Cloud Run injects PORT automatically (defaults to 8080 in the Dockerfile).
# PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * to allow all (dev only).
# Examples: https://app.example.com,https://studio.example.com
# ALLOWED_ORIGINS=*

# ── Authentication (production hardening) ────────────────────────────────────
# When set, clients must send this token in the X-API-Token header on /process-audio.
# Leave empty to disable authentication (dev mode). ALWAYS set this in production
# to prevent abuse of your Gemini quota.
# API_TOKEN=

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Structured logging: when set to "json", logs are emitted as JSON lines for
# Cloud Run / structured log collectors. Use "text" (default) for local dev.
# LOG_FORMAT=text

# ── Audio limits ──────────────────────────────────────────────────────────────
# Maximum allowed audio upload size in megabytes.
# MAX_AUDIO_MB=20

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Maximum number of /process-audio requests per client per minute. 0 disables.
# RATE_LIMIT_PER_MINUTE=30
